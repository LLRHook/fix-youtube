{
  "name": "fix-youtube",
  "version": "0.3.1",
  "private": true,
  "description": "Hide YouTube Shorts and recommendations, disable autoplay, and open Subscriptions by default. No settings or setup.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LLRHook/fix-youtube.git"
  },
  "scripts": {
    "test": "node --test",
    "build": "cargo run --locked --release --manifest-path tools/packager/Cargo.toml --",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 --test-force-exit \"tests/e2e/*.e2e.js\"",
    "test:packager": "cargo test --locked --manifest-path tools/packager/Cargo.toml && python3 tests/packager_parity.py"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "puppeteer": "25.12.0"
  }
}
